# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server only — Project Settings > API (service_role). Required for master-admin, CRM counts,
# and /api/notify-review. Never commit the real value or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Public base URL (QR links, emails, /demo). MUST be the deployed origin (https://…).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — https://resend.com (optional: if unset, /api/notify-review logs only, no email)
# Verify your sending domain in Resend; from-address is LocalReach <info.ae@miraireach.marketing> (route.ts)
# RESEND_API_KEY=re_xxxxxxxx

# Demo: set a real store UUID so /demo opens /store/{id} and WhatsApp save works on / too
# NEXT_PUBLIC_DEMO_STORE_ID=00000000-0000-0000-0000-000000000000

# Supabase Auth: Authentication > URL Configuration — set Site URL and Redirect URLs to
# NEXT_PUBLIC_APP_URL (production) so admin login cookies work after deploy.

# Deploy isolation (Vercel): create a NEW project for this app; set Root Directory to this
# folder (review_app_nextjs). Do not reuse another product’s project. Use a dedicated
# subdomain (e.g. app.miraireach.marketing) and a dedicated Supabase project when possible.

# Production: `next.config` requires https NEXT_PUBLIC_APP_URL when VERCEL_ENV=production.
# /api/notify-review blocks cross-site browser POSTs when an Origin header is present.

# Password reset: Supabase → Authentication → URL Configuration → Redirect URLs must include:
#   https://<your-production-domain>/auth/callback   and   http://localhost:3000/auth/callback
